# LLM Quality Pipeline reads no secrets from the environment.
#
# The newLXP email and password are typed at the sign-in screen, and the
# AI provider key is entered under "AI settings". Both are stored only in
# your home directory, readable by your user alone:
#
#   ~/.newlxp_session.json   login session (access and refresh tokens)
#   ~/.newlxp_ai.json        provider, API key, model and preferences
#
# Never commit those files. The variables below are optional and only
# change local behaviour.

# Python interpreter used by run.sh to create the virtual environment.
PYTHON=python3

# Editor for the system prompt. When unset, the desktop default
# (TextEdit, Notepad, xdg-open) is used.
EDITOR=
VISUAL=
